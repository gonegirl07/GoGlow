{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gonegirl07/GoGlow/blob/main/specs/prompt-rule.schema.json",
  "title": "GoGlow Prompt Rule",
  "description": "A versioned, evidence-backed instruction that can be composed into scene prompts. Status 'confirmed' records owner/tester acceptance for its stated scope; it is not a guarantee across models or poses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "version",
    "title",
    "status",
    "rule_type",
    "scope",
    "instructions",
    "provenance",
    "evidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "confirmed",
        "deprecated"
      ]
    },
    "rule_type": {
      "enum": [
        "start_state",
        "pose",
        "framing",
        "movement",
        "camera",
        "anatomy",
        "continuity",
        "wardrobe",
        "negative_constraint",
        "prompt_style"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activities"
      ],
      "properties": {
        "activities": {
          "type": "array",
          "items": {
            "enum": [
              "cycling",
              "yoga",
              "dance",
              "fashion",
              "other"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "pose_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "model_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "aspect_ratios": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "clip_durations_seconds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "resolution_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "avoid"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exact_prompt_fragment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rationale": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_note"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "owner_observation",
            "tester_observation",
            "external_reference",
            "model_suggestion",
            "manual_authoring"
          ]
        },
        "source_note": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "observed_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "summary"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pass",
              "fail",
              "mixed",
              "unverified"
            ]
          },
          "summary": {
            "type": "string"
          },
          "attempt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "clip_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "observed_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "qc_passed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "qc_total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "qc_checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    },
    "related_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
