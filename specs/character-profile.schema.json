{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoGlow Character Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "fixed_appearance", "default_wardrobe", "rules", "reference_images"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "fixed_appearance": {"type": "string", "minLength": 1, "description": "Fixed appearance description in ASCII English."},
    "default_wardrobe": {"type": "string", "minLength": 1, "description": "Default wardrobe description in ASCII English."},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "description": "Character-specific rules in ASCII English."}},
    "reference_images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "required": ["path"], "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "purpose": {"type": "string"}}}
        ]
      }
    },
    "notes": {"type": "string"}
  }
}
