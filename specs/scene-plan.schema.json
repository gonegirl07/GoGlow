{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoGlow Scene Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "aspect_ratio",
    "target_duration_seconds",
    "activity",
    "scenes"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "aspect_ratio": {
      "enum": ["9:16", "16:9", "1:1"]
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 30
    },
    "activity": {
      "enum": [
        "dance",
        "cycling",
        "yoga",
        "fashion",
        "other"
      ]
    },
    "character_id": {
      "type": "string"
    },
    "model_labels": {
      "type": "object",
      "properties": {
        "video": {
          "type": "string"
        },
        "image": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_seconds",
          "start_state",
          "primary_action",
          "end_state",
          "prompt",
          "qc_checklist"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wardrobe": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "start_state": {
            "type": "string",
            "minLength": 1
          },
          "primary_action": {
            "type": "string",
            "minLength": 1
          },
          "motion_direction": {
            "type": "string"
          },
          "speed_and_timing": {
            "type": "string"
          },
          "body_mechanics": {
            "type": "string"
          },
          "camera": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "end_state": {
            "type": "string",
            "minLength": 1
          },
          "continuity_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "continuity_out": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_brief": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qc_checklist": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "PLANNED",
              "PROMPT_READY",
              "WAITING_FOR_GENERATION",
              "GENERATED",
              "QC_REVIEW",
              "NEEDS_REVISION",
              "PROMPT_REVISED",
              "APPROVED",
              "BLOCKED"
            ],
            "default": "PLANNED"
          },
          "media_uri": {
            "type": "string"
          },
          "flow_clip_seconds": {
            "enum": ["8", "10"],
            "default": "8"
          },
          "pose_reference_uri": {"type": "string"},
          "face_reference_uri": {"type": "string"},
          "media_uri_360p": {"type": "string"},
          "media_uri_720p": {"type": "string"},
          "breath_cue": {"type": "string"},
          "movement_benefit": {"type": "string"},
          "edit_transition": {"enum": ["hard_cut", "crossfade", "fade"], "default": "hard_cut"},
          "watermark_status": {"enum": ["not_checked", "removed", "not_present"], "default": "not_checked"},
          "review_notes": {
            "type": "string"
          },
          "status_history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "PLANNED",
                "PROMPT_READY",
                "WAITING_FOR_GENERATION",
                "GENERATED",
                "QC_REVIEW",
                "NEEDS_REVISION",
                "PROMPT_REVISED",
                "APPROVED",
                "BLOCKED"
              ]
            }
          },
          "qc_report": {
            "$ref": "./qc-report.schema.json"
          },
          "qc_draft": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "review_status": {
                "enum": [
                  "PASS",
                  "REVIEW",
                  "FAIL",
                  "NOT_REVIEWED"
                ]
              },
              "reviewed_by": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string",
                "description": "Local datetime input draft; converted to ISO 8601 when saved as qc_report."
              },
              "defects": {
                "type": "string"
              },
              "revision_prompt": {
                "type": "string"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "category",
                    "status",
                    "notes"
                  ],
                  "properties": {
                    "category": {
                      "enum": [
                        "identity",
                        "anatomy",
                        "action",
                        "physics",
                        "continuity",
                        "camera",
                        "artifacts",
                        "duration",
                        "format",
                        "other",
                        "yoga_framing",
                        "yoga_foot_sliding",
                        "yoga_joint_alignment",
                        "yoga_left_right",
                        "yoga_wardrobe_coverage"
                      ]
                    },
                    "status": {
                      "enum": [
                        "PASS",
                        "REVIEW",
                        "FAIL",
                        "NOT_CHECKED"
                      ]
                    },
                    "notes": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PROMPT_READY",
                    "WAITING_FOR_GENERATION",
                    "GENERATED",
                    "QC_REVIEW",
                    "NEEDS_REVISION",
                    "PROMPT_REVISED",
                    "APPROVED",
                    "BLOCKED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "status_history"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "GENERATED",
                    "QC_REVIEW",
                    "APPROVED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "media_uri",
                "status_history"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "APPROVED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "qc_report",
                "media_uri",
                "status_history"
              ]
            }
          }
        ]
      }
    },
    "project_name": {
      "type": "string"
    },
    "character_name": {
      "type": "string"
    },
    "brief": {
      "type": "string"
    },
    "music_direction": {"type": "string"},
    "editing_notes": {"type": "string"},
    "pre_publish_approved": {"type": "boolean"},
    "ai_label_required": {"type": "boolean"},
    "auto_advance": {"type": "boolean"},
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "planner": {
          "type": "string"
        },
        "model_called": {
          "type": "boolean"
        },
        "media_reviewed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "scene_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "auto_advance": {
      "type": "boolean",
      "description": "Browser preference: automatically advance after manual evidence gates pass."
    }
  }
}
