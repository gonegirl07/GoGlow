{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoGlow QC Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_id",
    "review_status",
    "checks",
    "reviewed_by",
    "reviewed_at",
    "media_uri",
    "activity"
  ],
  "properties": {
    "scene_id": {
      "type": "string"
    },
    "review_status": {
      "enum": [
        "PASS",
        "REVIEW",
        "FAIL",
        "NOT_REVIEWED"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "status",
          "notes"
        ],
        "properties": {
          "category": {
            "enum": [
              "identity",
              "anatomy",
              "action",
              "physics",
              "continuity",
              "camera",
              "artifacts",
              "duration",
              "format",
              "other",
              "yoga_framing",
              "yoga_foot_sliding",
              "yoga_joint_alignment",
              "yoga_left_right",
              "yoga_wardrobe_coverage"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "REVIEW",
              "FAIL",
              "NOT_CHECKED"
            ]
          },
          "notes": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_prompt": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "media_uri": {
      "type": "string"
    },
    "activity": {
      "type": "string",
      "enum": [
        "cycling",
        "yoga",
        "dance",
        "fashion",
        "walking",
        "fitness",
        "other"
      ]
    }
  }
}
