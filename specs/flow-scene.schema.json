{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoGlow Per-Scene Flow Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_id",
    "reference_images",
    "character_description",
    "model",
    "resolution",
    "prompt"
  ],
  "properties": {
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Local path to a PNG, JPG, JPEG, or WEBP file. Relative paths resolve from the scene JSON directory."
      }
    },
    "character_description": {
      "type": "string",
      "minLength": 1,
      "description": "ASCII English description of the person in the supplied reference images."
    },
    "model": {
      "const": "Omni 1.1 Flash"
    },
    "resolution": {
      "const": "360p"
    },
    "duration": {
      "const": "8s"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "ASCII English scene/action/wardrobe/constraint prompt."
    }
  }
}
